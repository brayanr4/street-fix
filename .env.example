# Optional. Without it, Street Fix uses templates instead of AI.
ANTHROPIC_API_KEY=

# Automatic sending. Without these, people copy the report into the agency's website.
# Get a key at resend.com and verify your domain there first.
RESEND_API_KEY=
MAIL_FROM="Street Fix <reports@your-domain.com.au>"
# Any long random string. The hourly follow-up job uses it to call /api/cron.
CRON_SECRET=
